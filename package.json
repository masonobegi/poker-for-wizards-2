{
  "name": "hexhold",
  "productName": "HEXHOLD",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "HEXHOLD - impossible poker. Online multiplayer Texas Hold'em where the deck breaks the laws of physics.",
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "start": "node --import tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -p tsconfig.app.json --noEmit",
    "test": "node --import tsx --test test/hand.test.ts test/sigils.test.ts test/net.test.ts",
    "sim": "tsx test/sim.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "framer-motion": "^11.18.2",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}