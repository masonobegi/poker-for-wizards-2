{
  "name": "hexhold",
  "productName": "HEXHOLD",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "HEXHOLD - impossible poker. Online multiplayer Texas Hold'em where the deck breaks the laws of physics.",
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "start": "node --import tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/hand.test.ts test/sigils.test.ts test/omens.test.ts test/pot.test.ts test/render.test.tsx test/persist.test.ts test/net.test.ts test/skill.test.ts test/botmagic.test.ts test/hexes.test.ts test/config.test.ts test/achievements.test.ts test/motion.test.ts test/marks.test.tsx test/css.test.ts",
    "sim": "tsx test/sim.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-server/index.mjs --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire as __hxcr}from'node:module';const require=__hxcr(import.meta.url);\"",
    "build:all": "npm run build && npm run build:server",
    "electron:dev": "concurrently -n server,vite,electron -c magenta,cyan,yellow \"npm:dev:server\" \"npm:dev:client\" \"wait-on tcp:5173 && electron .\"",
    "package": "npm run icon && npm run build:all && electron-builder --publish never",
    "package:win": "npm run icon && npm run build:all && electron-builder --win --publish never",
    "package:linux": "npm run icon && npm run build:all && electron-builder --linux --publish never",
    "icon": "node electron/make-icon.mjs",
    "metrics": "tsx test/metrics.ts",
    "runs": "tsx test/runs.ts",
    "play": "node test/playthrough.mjs",
    "record": "node test/record.mjs",
    "play:pad": "node test/gamepad.mjs",
    "steam:manifest": "tsx scripts/steam-manifest.mjs",
    "audio": "node test/audio.mjs",
    "responsive": "node test/responsive.mjs",
    "audio:calibrate": "node scripts/calibrate-audio.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "framer-motion": "^11.18.2",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^9.1.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.hexhold.game",
    "productName": "HEXHOLD",
    "copyright": "HEXHOLD",
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "client"
      },
      {
        "from": "dist-server",
        "to": "server"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "icon": "electron/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.card-games",
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "HEXHOLD"
    }
  },
  "author": "Mason Obegi",
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  }
}
