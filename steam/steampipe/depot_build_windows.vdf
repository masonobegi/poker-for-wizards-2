"DepotBuild"
{
	"DepotID" "DEPOT_ID_WINDOWS"
	// Relative to the app build's ContentRoot (release/).
	"ContentRoot" "win-unpacked\"

	"FileMapping"
	{
		"LocalPath" "*"
		"DepotPath" "."
		"Recursive" "1"
	}

	// Never ship a test App ID beside the binary.
	"FileExclusion" "steam_appid.txt"
	"FileExclusion" "*.pdb"
}
