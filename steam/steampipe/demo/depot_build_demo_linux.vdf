"DepotBuild"
{
	"DepotID" "DEMO_DEPOT_ID_LINUX"
	// Relative to the app build's ContentRoot (release-demo/). Upload it from
	// the WSL build (~/hexhold-main/release-demo/linux-unpacked), which keeps
	// the execute bits a Windows copy loses.
	"ContentRoot" "linux-unpacked\"

	"FileMapping"
	{
		"LocalPath" "*"
		"DepotPath" "."
		"Recursive" "1"
	}

	"FileExclusion" "steam_appid.txt"
}
