"DepotBuild"
{
	"DepotID" "DEPOT_ID_LINUX"
	// Relative to the app build's ContentRoot (release/). Produced by
	// `npm run package:linux`. Build and upload it from WSL or Linux
	// (~/hexhold-main, STEAM-READY.md): a copy made on Windows loses the execute
	// bits, and the stale Windows-side copy was removed on 2026-10-22 so that an
	// upload from Windows fails rather than ships an old build.
	"ContentRoot" "linux-unpacked\"

	"FileMapping"
	{
		"LocalPath" "*"
		"DepotPath" "."
		"Recursive" "1"
	}

	"FileExclusion" "steam_appid.txt"
}
